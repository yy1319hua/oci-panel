[server]
port = "8999"

[web]
account = "admin"
# 密码：可填明文，也可填 bcrypt 哈希（以 $2a$/$2b$/$2y$ 开头）。
# 推荐使用 bcrypt 哈希，避免明文泄露。生成方式（任选其一）：
#   htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
#   或 docker run --rm httpd:alpine htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
password = ""
# JWT 签名密钥。留空时服务会自动生成一个随机密钥并持久化到数据库（重启后保持不变）。
# 也可显式指定（优先级高于自动生成）。已移除此前硬编码的公开默认密钥。
jwt_secret = ""
# 允许跨域访问的来源白名单（精确匹配 Origin，含协议与端口）。
# 留空表示仅允许同源访问——生产环境前端由本服务同源托管时无需配置。
# 仅当前端与 API 部署在不同来源时才需要填写，例如：["https://panel.example.com"]
allow_origins = []

[database]
dsn = "db/oci-helper.db"

[logging]
level = "info"

[passkey]
# Relying Party ID - 通常是你的域名，不包含协议和端口
# 本地开发使用 "localhost"，生产环境使用实际域名如 "example.com"
rp_id = "localhost"
# 允许的来源列表，包含协议和端口
# 本地开发: ["http://localhost:8999"]
# 生产环境: ["https://example.com"]
rp_origins = ["http://localhost:8999"]

[email]
# 邮件服务提供商（目前仅支持 resend）
provider = "resend"
# Resend 控制台的 API Key（https://resend.com/api-keys）
resend_api_key = ""
# 发件人地址，必须属于已在 Resend 验证过的域名。
# 可带显示名，例如："OCI Panel <noreply@yourdomain.com>"
from = ""
# 面板对外访问地址，用于拼接密码重置链接
public_url = "https://oci.example.com"
