# ============ ARM64 交叉编译版（在 x86_64 沙箱构建，产物为 aarch64）============
# 设计要点：沙箱无法运行 qemu 模拟，因此 final 阶段只 COPY 不 RUN。
# ca-certificates / tzdata 为架构无关的纯数据，从 amd64 构建阶段直接复制。

# Stage 1: 前端构建（amd64 原生，npm 打包与架构无关）
FROM --platform=linux/amd64 node:22-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --registry=https://registry.npmmirror.com
COPY frontend/ ./
RUN npm run build

# Stage 2: 后端构建（amd64 原生运行，交叉编译出 arm64 二进制）
FROM --platform=linux/amd64 golang:1.24-alpine AS backend-builder
WORKDIR /app
# ca-certificates / tzdata 纯数据，稍后复制进 final 镜像
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
    && apk add --no-cache ca-certificates tzdata
COPY go.mod go.sum ./
ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=off
RUN go mod download
COPY . .
# 交叉编译：amd64 主机直接产出 arm64(aarch64) 静态二进制，无需 qemu
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags "-s -w" -o oci-panel main.go

# Stage 3: 最终 arm64 镜像（仅 COPY，不 RUN —— 不需要 qemu）
FROM --platform=linux/arm64 alpine:3.21
WORKDIR /app
ENV TZ=Asia/Shanghai
# 复制架构无关的证书与时区数据
COPY --from=backend-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=backend-builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=backend-builder /app/oci-panel .
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist
COPY config.toml.example ./config.toml
EXPOSE 8999
CMD ["./oci-panel"]
